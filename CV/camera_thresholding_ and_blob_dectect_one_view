"""
Live blob detection with OpenCV for ASL Glove CV work.
Captures frames, thresholds bright IR markers, and highlights blobs in real time.
Synchronizes frame capture with ESP32 LED flashing via serial messages.
Logs FPS, frame count, LED index, and blob coordinates to a timestamped CSV file.
"""

# Suppress linter false positives about cv2 dynamic attributes
# pylint: disable=E1101

import time
from typing import Any
import serial  # type: ignore
import serial.tools.list_ports  # type: ignore
import numpy as np
import cv2

def find_esp32_port() -> str | Any:
    """
    Automatically detect the ESP32 serial port.
    Scans connected devices for typical ESP32 identifiers like "usbserial" or "ttyUSB".
    Returns the detected port string or None if not found.
    """
    ports = serial.tools.list_ports.comports()
    for port in ports:
        if (
            "usbserial" in port.device.lower()
            or "ttyusb" in port.device.lower()
            or "ttyacm" in port.device.lower()
            or "esp" in port.description.lower()
        ):
            print(f"✅ Found ESP32 at {port.device}")
            return port.device
    print("⚠️ ESP32 not found — connect and try again.")
    return None

def main() -> None:
    """Main loop to capture frames, detect blobs, and log data."""

    print("OpenCV version:", cv2.__version__)
    
    # --- Automatically find the ESP32 serial port ---
    port = find_esp32_port()
    if port is None:
        return

    # --- Serial setup (update port name if needed) ---
    ser = serial.Serial(port, 115200, timeout=1)
    time.sleep(2)  # Give the ESP32 time to reset after serial connect
    print("🔌 Serial connected to ESP32")

    # --- Camera setup ---
    cap = cv2.VideoCapture(0)  # Open default camera (index 0)
    # Force MJPG to unlock 60 fps mode
    cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*'MJPG'))  # type: ignore[attr-defined]
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)   # Request 1280px wide frames
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)   # Request 720px tall frames
    cap.set(cv2.CAP_PROP_FPS, 60)             # Request 60 frames per second
    
    print("FOURCC:", int(cap.get(cv2.CAP_PROP_FOURCC)))
    fcc = int(cap.get(cv2.CAP_PROP_FOURCC))
    print("FOURCC decoded:", "".join([chr((fcc >> 8*i) & 0xFF) for i in range(4)]))
    print("Width:", cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    print("Height:", cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    print("FPS (reported):", cap.get(cv2.CAP_PROP_FPS))

    if not cap.isOpened():
        print("❌ Error: Could not open camera.")
        return

    # --- Parameters for blob filtering ---
    THRESH = 240          # Brightness threshold (0–255)
    MIN_AREA = 300         # Minimum blob area in pixels^2
    MAX_AREA = 10000       # Maximum blob area in pixels^2
    MIN_CIRCULARITY = 0.6 # Require blobs to be round (0–1)

    kernel = np.ones((3, 3), np.uint8)  # Morphology kernel for cleanup

    # --- FPS + frame counters ---
    prev_time = time.time()
    fps = 0.0
    frame_count = 0
    led_index = 0  # Which LED was active during this frame
    
    # --- Setup OpenCV display window ---
    cv2.namedWindow("Detections", cv2.WINDOW_NORMAL)
    cv2.resizeWindow("Detections", 1280, 720)

    # --- Kick off LED sequence ---
    ser.write(b"START\n")
    
    while True:
         # --- Wait for ESP32 sync message ---
        line = ser.readline().decode(errors="ignore").strip()
        if not line:
            continue

        # Expecting lines like "READY:1" meaning LED 1 just turned on
        if line.startswith("READY"):
            try:
                led_index = int(line.split(":")[1])
            except (IndexError, ValueError):
                led_index = -1

            print(f"📸 Capturing frame for LED {led_index}")
            
        # --- Capture frame ---
        ret, frame = cap.read()
        if not ret:
            print("❌ Error: Failed to grab frame.")
            break

        frame_count += 1

        # --- Preprocessing ---
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)   # Grayscale, IR LEDs don't need color info, just brightness
        blurred = cv2.GaussianBlur(gray, (5, 5), 0)      # Gaussian blur with 5x5 kernel to reduce noise

        # --- Thresholding ---
        _, mask = cv2.threshold(blurred, THRESH, 255, cv2.THRESH_BINARY)  # Binary threshold to isolate bright spots, any pixel brighter than THRESH (200) becomes white (255), others black (0)

        # --- Clean mask ---
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel, iterations=1) # Morphological open to remove small specks (noise), kernel = 3x3 matrix of ones, iterations = 1 applies the operation once
        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel, iterations=2) # Morphological close to fill small holes in blobs, iterations = 2 applies the operation twice for better effect
        
        # --- Find blobs ---
        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE) # Find contours (blobs) in the binary mask, only retrieves outmost contours, compresses contour points to save memeory, contour is a list of all candidate LED blobs for further filtering
        blob_centers = []                          # List to hold blob center coordinates
        for c in contours:                         # Loops over to analyze each contour (a curve joining all the boundary points of a white blob in the thresholded image)
            area = cv2.contourArea(c)              # Calculate area of each contour
            if area < MIN_AREA or area > MAX_AREA: # skips blobs if they are too small (noise) or too large (not an LED)
                continue

            per = cv2.arcLength(c, True)           # Calculates the perimeter of contour (how round the blob is)
            if per <= 0:                           # Safety check to avoid division by zero
                continue

            circularity = 4 * np.pi * area / (per * per + 1e-9) # Calculates the circularity of the blob (perfect circle about= 1, very irregular shape < 0.5)
            if circularity < MIN_CIRCULARITY:                   # discards blobs that aren't circular enough (noise, streaks)
                continue

            M = cv2.moments(c)                   # Computes image moments for the contour (moments are particular weighted averages of image pixel intensities (help calculate centroid)
            if M["m00"] == 0:                    # Safety check to avoid division by zero
                continue                                # ***************** ADD CALIBRATION HERE WITH IMUS ****************************** make sure IMUs and OpenCV has the same zeros (coordinates)
            cx, cy = int(M["m10"] / M["m00"]), int(M["m01"] / M["m00"])     # computes the centroid of the blob     
            blob_centers.append((cx, cy))                                   # cx = x-coordinate of centroid, cy = y-coordinate of centroid, adds the centroid coordinates to the list of blob centers

            # Draw bounding box
            (x, y, w, h) = cv2.boundingRect(c)                             # computes the bounding box around the blob (x,y are the top-left coordinates, w is width, h is height)
            cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 0), 2)   # draws a green rectangle around the blob on the live feed
            cv2.putText(frame, f"({cx},{cy})", (x, y - 10),                # prints the coordinates of the centroid above the bounding box
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 1, cv2.LINE_AA)

        # --- FPS calculation ---
        curr_time = time.time()                   # Record the current timestamp (in seconds since the epoch)
        elapsed = curr_time - prev_time           # Time difference since last frame
        if elapsed > 0:                           # Avoid divide-by-zero errors
            fps = 1.0 / elapsed                   # FPS = frames per second (reciprocal of frame duration)
        prev_time = curr_time                     # Update prev_time for next iteration

        # --- Overlay FPS + frame count ---
        cv2.putText(frame, f"FPS: {fps:.1f}", (10, 25),       # draws text overlays directly on the video frame, first line shows the FPS, formatted with one decimal, second line shows the frame number since the start of the run
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 255), 2, cv2.LINE_AA)    # (10, 25) and (10, 55) are pixel coordinates (x, y) for the text position.
        cv2.putText(frame, f"Frame: {frame_count}", (10, 55),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 200, 255), 2, cv2.LINE_AA)    # (0, 255, 255) = yellow color (BGR format), (0, 200, 255) = orange-ish.  

        # --- Show one view ---
        # Show views
        # cv2.imshow("Threshold Mask", mask)
        cv2.imshow("Detections", frame)   # <-- switched from 'blurred' to 'frame'

        # --- Tell ESP32 to move to next LED ---
        ser.write(b"NEXT\n")
        led_index = (led_index + 1) % 5  # assuming 5 LEDs

        # --- Keyboard controls ---
        k = cv2.waitKey(1) & 0xFF         # Capture key press (waits 1ms)
        if k == ord("q"):                 # If 'q' pressed → quit program
            break
        elif k in (ord("+"), ord("=")):   # If '+' pressed → increase threshold
            THRESH = min(255, THRESH + 2)
            print("Threshold:", THRESH)
        elif k in (ord("-"), ord("_")):   # If '-' pressed → decrease threshold
            THRESH = max(0, THRESH - 2)
            print("Threshold:", THRESH)

    # --- Cleanup ---
    cap.release()              # Release the camera so other apps can use it
    # log_file.close()           # Close the CSV log file safely
    ser.close()                # Close the serial connection
    cv2.destroyAllWindows()    # Close all OpenCV display windows


if __name__ == "__main__":
    main()